node_modules/
**/node_modules/

dist/
**/dist/

.angular/
**/.angular/

coverage/
**/coverage/

.nx/
**/.nx/

.next/
**/.next/

out/
**/out/


# =========================
# VS Code
# =========================

# Ignore every .vscode directory by default
**/.vscode/

# Allow the root .vscode directory to be inspected
!/.vscode/

# Ignore everything inside the root .vscode directory
/.vscode/*

# Keep only the shared root settings
!/.vscode/settings.json


# =========================
# IntelliJ IDEA
# =========================

.idea/
**/.idea/
*.iml
*.iws
*.ipr


