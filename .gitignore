# =========================
# Environment / secrets
# =========================

.env
**/.env
.env.*
**/.env.*

# Keep environment templates
!.env.example
!**/.env.example

# Local Spring configuration / secrets
application-local.yml
**/application-local.yml
application-local.yaml
**/application-local.yaml
application-local.properties
**/application-local.properties


# =========================
# Java / Maven
# =========================

target/
**/target/

*.class
*.jar
*.war
*.ear

# Maven local/generated files
.mvn/timing.properties
**/.mvn/timing.properties

# JVM crash / diagnostic files
hs_err_pid*
replay_pid*
*.hprof


# =========================
